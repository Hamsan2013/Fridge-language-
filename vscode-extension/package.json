{
  "name": "fridge-language",
  "displayName": "FRIDGE",
  "description": "Official language support, multi-color syntax highlighting, live error checking, hover previews, and 2D/3D engine runner for FRIDGE v0.5.0.",
  "version": "0.5.0",
  "publisher": "AD-Developers",
  "license": "SEE LICENSE IN LICENSE.md",
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hamsan2013/Fridge-language-"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:fridge"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fridge",
        "aliases": ["FRIDGE", "fridge"],
        "extensions": [".frg", ".uzip"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/icon.png",
          "dark": "./icons/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "fridge",
        "scopeName": "source.frg",
        "path": "./syntaxes/fridge.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "fridge.runFile",
        "title": "FRIDGE: Run Current File",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "fridge.runFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == fridge"
      }
    ],
    "menus": [
      {
        "editor/title/run": [
          {
            "command": "fridge.runFile",
            "when": "editorLangId == fridge",
            "group": "navigation"
          }
        ],
        "editor/context": [
          {
            "command": "fridge.runFile",
            "when": "editorLangId == fridge",
            "group": "navigation"
          }
        ]
      }
    ],
    "configuration": {
      "title": "FRIDGE Language",
      "properties": {
        "fridge.executablePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the fridge executable."
        },
        "fridge.clearTerminalBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Clear the terminal before launching a FRIDGE program."
        }
      }
    },
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true,
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "invalid.illegal.danger.fridge",
            "settings": { "foreground": "#FF4D4D", "fontStyle": "bold" }
          },
          {
            "scope": "keyword.operator.twoletter.fridge",
            "settings": { "foreground": "#FF5555", "fontStyle": "bold" }
          },
          {
            "scope": "keyword.control.fridge",
            "settings": { "foreground": "#C678DD", "fontStyle": "bold" }
          },
          {
            "scope": "storage.type.fridge",
            "settings": { "foreground": "#56B6C2", "fontStyle": "bold" }
          },
          {
            "scope": "support.function.io.fridge",
            "settings": { "foreground": "#E5C07B", "fontStyle": "bold" }
          },
          {
            "scope": "support.class.engine.fridge",
            "settings": { "foreground": "#2BBAC5", "fontStyle": "bold" }
          },
          {
            "scope": "entity.name.function.fridge",
            "settings": { "foreground": "#61AFEF", "fontStyle": "bold" }
          },
          {
            "scope": "variable.other.fridge",
            "settings": { "foreground": "#ABB2BF" }
          },
          {
            "scope": "string.quoted.double.fridge",
            "settings": { "foreground": "#E06C75" }
          },
          {
            "scope": "constant.numeric.fridge, constant.language.fridge",
            "settings": { "foreground": "#98C379" }
          }
        ]
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
